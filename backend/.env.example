# Local development database.
# Production MVP target: PostgreSQL with pg_trgm and pgvector extensions.
# Local fallback: sqlite+aiosqlite:///./dev_cp_recovery.db
DATABASE_URL=

# Mock Plugin UI local development origins.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8001,http://127.0.0.1:8001

# LLM providers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
VLLM_GEMMA_BASE_URL=http://localhost:8002/v1
VLLM_GEMMA_MODEL=gemma-4b

# RAG defaults from the P6 blueprint.
RAG_CHUNK_SIZE_CHARS=1200
RAG_CHUNK_OVERLAP_CHARS=200
RAG_VECTOR_TOP_K=20
RAG_FINAL_TOP_K=8
RAG_MIN_SCORE=0.35
