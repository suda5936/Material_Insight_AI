# Use PostgreSQL in real/dev server environments.
# Example:
# DATABASE_URL=postgresql+psycopg://material_user:material_password@localhost:5432/material_insight

# If DATABASE_URL is omitted, the backend falls back to SQLite for local development.
DATABASE_URL=

# LLM provider selection for Phase 5.
# Recommended MVP default:
# - openai for production-quality structured recommendations
# - mock for offline tests and demos
# - vllm for local/private model experiments
LLM_PROVIDER=mock

# OpenAI provider settings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# vLLM OpenAI-compatible provider settings.
# Available local models: qwen-27b, gemma-4b
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=qwen-27b

# RAG retrieval provider.
# local: YAML/Markdown sample retrieval
# pgvector: PostgreSQL pgvector retrieval with local fallback
RAG_RETRIEVER_PROVIDER=local
EMBEDDING_PROVIDER=local_hash
EMBEDDING_DIMENSIONS=64
PGVECTOR_MIN_RELEVANCE_SCORE=5.0

# Mock Plugin UI local development origins.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8001,http://127.0.0.1:8001
